\name{worknoiser_language}
\alias{worknoiser_language}
\alias{set_worknoiser_language}
\title{WorknoiseR language / Idioma de WorknoiseR}
\usage{
worknoiser_language()

set_worknoiser_language(language = c("es", "en"))
}
\arguments{\item{language}{Language code \code{"es"} or \code{"en"}. / Código de idioma \code{"es"} o \code{"en"}.}}
\description{Gets or sets the language used for human-readable WorknoiseR messages and summaries. / Obtiene o establece el idioma utilizado en mensajes y resúmenes legibles de WorknoiseR.}
\value{The active language, or invisibly the previous language when setting it. / El idioma activo o, al establecerlo, el idioma anterior de forma invisible.}
